# Public deployment configuration only. Never put seed phrases or private keys here.
SUI_NETWORK=testnet
SUPERCUTS_DEPLOYMENT_DOMAIN_HEX=
SUPERCUTS_PACKAGE_ID=
SUPERCUTS_POOL_ID=
SUPERCUTS_COIN_TYPE=
SUPERCUTS_VERIFIER_VERSION=1

# Credential values belong in an untracked operator environment.
TATUM_API_KEY=
WALRUS_MEMORY_ENDPOINT=
WALRUS_MEMORY_DELEGATE_KEY=
WALRUS_MEMORY_ACCOUNT_ID=
# Required for client-managed encryption using MemWalManual.
WALRUS_MEMORY_PACKAGE_ID=
WALRUS_MEMORY_REGISTRY_ID=
WALRUS_MEMORY_NETWORK=mainnet
# Local OpenAI-compatible adapter. The API key is a non-secret placeholder when
# the adapter runs on localhost; it is required by MemWal's client config.
EMBEDDING_ENDPOINT=http://127.0.0.1:8787/v1
EMBEDDING_API_KEY=local-placeholder
EMBEDDING_MODEL=embeddinggemma-1536
# Adapter upstream (for example, Ollama's OpenAI-compatible endpoint).
EMBEDDING_UPSTREAM_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_UPSTREAM_MODEL=embeddinggemma
EMBEDDING_ADAPTER_PORT=8787
X402_FACILITATOR_URL=

