pragma circom 2.2.3;

include "lib/statement_digest.circom";
include "lib/protocol_v2.circom";
include "lib/eddsa_strict.circom";

template Transfer(depth) {
    signal input statement[354];
    signal input digestHigh;
    signal input digestLow;

    signal input dealId;
    signal input revision;
    signal input transcriptRootLo;
    signal input transcriptRootHi;
    signal input serviceDigestLo;
    signal input serviceDigestHi;
    signal input settlementNonceLo;
    signal input settlementNonceHi;
    signal input paymentAmount;
    signal input blinding;
    signal input buyerAx;
    signal input buyerAy;
    signal input sellerAx;
    signal input sellerAy;
    signal input recipientSpendTag;
    signal input buyerR8x;
    signal input buyerR8y;
    signal input buyerS;
    signal input sellerR8x;
    signal input sellerR8y;
    signal input sellerS;

    signal input inputAmount;
    signal input inputSalt;
    signal input inputSpendSecret;
    signal input inputLeafIndex;
    signal input inputPath[depth];
    signal input changeAmount;
    signal input changeSpendSecret;
    signal input changeSalt;
    signal input paymentAppendPath[depth];
    signal input changeAppendPath[depth];

    component digest = StatementDigest(354);
    for (var i = 0; i < 354; i++) digest.statement[i] <== statement[i];
    digest.digestHigh <== digestHigh;
    digest.digestLow <== digestLow;
    component header = StatementHeader(2);
    for (var i = 0; i < 106; i++) header.statement[i] <== statement[i];

    component dealCommitment = DecodeField(354, 106);
    component dealNullifier = DecodeField(354, 138);
    component inputNullifier = DecodeField(354, 170);
    component paymentCommitment = DecodeField(354, 202);
    component changeCommitment = DecodeField(354, 234);
    component expiry = DecodeU64(354, 266);
    component oldRoot = DecodeField(354, 274);
    component oldIndex = DecodeU64(354, 306);
    component newRoot = DecodeField(354, 314);
    component newIndex = DecodeU64(354, 346);
    for (var i = 0; i < 354; i++) {
        dealCommitment.statement[i] <== statement[i];
        dealNullifier.statement[i] <== statement[i];
        inputNullifier.statement[i] <== statement[i];
        paymentCommitment.statement[i] <== statement[i];
        changeCommitment.statement[i] <== statement[i];
        expiry.statement[i] <== statement[i];
        oldRoot.statement[i] <== statement[i];
        oldIndex.statement[i] <== statement[i];
        newRoot.statement[i] <== statement[i];
        newIndex.statement[i] <== statement[i];
    }

    component dealIdRange = Num2Bits(128); dealIdRange.in <== dealId;
    component revisionRange = Num2Bits(32); revisionRange.in <== revision;
    component transcriptLoRange = Num2Bits(128); transcriptLoRange.in <== transcriptRootLo;
    component transcriptHiRange = Num2Bits(128); transcriptHiRange.in <== transcriptRootHi;
    component serviceLoRange = Num2Bits(128); serviceLoRange.in <== serviceDigestLo;
    component serviceHiRange = Num2Bits(128); serviceHiRange.in <== serviceDigestHi;
    component nonceLoRange = Num2Bits(128); nonceLoRange.in <== settlementNonceLo;
    component nonceHiRange = Num2Bits(128); nonceHiRange.in <== settlementNonceHi;
    component paymentRange = Num2Bits(64); paymentRange.in <== paymentAmount;
    component inputRange = Num2Bits(64); inputRange.in <== inputAmount;
    component changeRange = Num2Bits(64); changeRange.in <== changeAmount;
    component oldIndexRange = Num2Bits(depth); oldIndexRange.in <== oldIndex.value;
    component inputIndexRange = Num2Bits(depth); inputIndexRange.in <== inputLeafIndex;
    newIndex.value === oldIndex.value + 2;
    inputAmount === paymentAmount + changeAmount;

    component paymentZero = IsZero(); paymentZero.in <== paymentAmount; paymentZero.out === 0;
    component revisionZero = IsZero(); revisionZero.in <== revision; revisionZero.out === 0;
    component blindingZero = IsZero(); blindingZero.in <== blinding; blindingZero.out === 0;
    component inputSecretZero = IsZero(); inputSecretZero.in <== inputSpendSecret; inputSecretZero.out === 0;
    component changeSecretZero = IsZero(); changeSecretZero.in <== changeSpendSecret; changeSecretZero.out === 0;
    component recipientTagZero = IsZero(); recipientTagZero.in <== recipientSpendTag; recipientTagZero.out === 0;

    component paymentSalt = Poseidon(4);
    paymentSalt.inputs[0] <== 2009;
    paymentSalt.inputs[1] <== header.deployment;
    paymentSalt.inputs[2] <== settlementNonceLo;
    paymentSalt.inputs[3] <== settlementNonceHi;

    component termsA = Poseidon(6);
    termsA.inputs[0] <== 2001;
    termsA.inputs[1] <== header.deployment;
    termsA.inputs[2] <== dealId;
    termsA.inputs[3] <== revision;
    termsA.inputs[4] <== transcriptRootLo;
    termsA.inputs[5] <== transcriptRootHi;
    component termsB = Poseidon(6);
    termsB.inputs[0] <== serviceDigestLo;
    termsB.inputs[1] <== serviceDigestHi;
    termsB.inputs[2] <== settlementNonceLo;
    termsB.inputs[3] <== settlementNonceHi;
    termsB.inputs[4] <== paymentAmount;
    termsB.inputs[5] <== expiry.value;
    component termsC = Poseidon(6);
    termsC.inputs[0] <== buyerAx;
    termsC.inputs[1] <== buyerAy;
    termsC.inputs[2] <== sellerAx;
    termsC.inputs[3] <== sellerAy;
    termsC.inputs[4] <== recipientSpendTag;
    termsC.inputs[5] <== paymentSalt.out;
    component agreement = Poseidon(6);
    agreement.inputs[0] <== 2002;
    agreement.inputs[1] <== termsA.out;
    agreement.inputs[2] <== termsB.out;
    agreement.inputs[3] <== termsC.out;
    agreement.inputs[4] <== blinding;
    agreement.inputs[5] <== expiry.value;
    agreement.out === dealCommitment.value;

    component logicalDeal = Poseidon(6);
    logicalDeal.inputs[0] <== 2003;
    logicalDeal.inputs[1] <== header.deployment;
    logicalDeal.inputs[2] <== buyerAx;
    logicalDeal.inputs[3] <== buyerAy;
    logicalDeal.inputs[4] <== settlementNonceLo;
    logicalDeal.inputs[5] <== settlementNonceHi;
    logicalDeal.out === dealNullifier.value;

    component buyerMessage = Poseidon(3);
    buyerMessage.inputs[0] <== 2004;
    buyerMessage.inputs[1] <== header.deployment;
    buyerMessage.inputs[2] <== agreement.out;
    component sellerMessage = Poseidon(3);
    sellerMessage.inputs[0] <== 2005;
    sellerMessage.inputs[1] <== header.deployment;
    sellerMessage.inputs[2] <== agreement.out;
    component buyerAuth = EddsaStrictVerifier();
    buyerAuth.enabled <== 1;
    buyerAuth.Ax <== buyerAx; buyerAuth.Ay <== buyerAy;
    buyerAuth.R8x <== buyerR8x; buyerAuth.R8y <== buyerR8y;
    buyerAuth.S <== buyerS; buyerAuth.M <== buyerMessage.out;
    component sellerAuth = EddsaStrictVerifier();
    sellerAuth.enabled <== 1;
    sellerAuth.Ax <== sellerAx; sellerAuth.Ay <== sellerAy;
    sellerAuth.R8x <== sellerR8x; sellerAuth.R8y <== sellerR8y;
    sellerAuth.S <== sellerS; sellerAuth.M <== sellerMessage.out;

    component inputSpendTag = Poseidon(2);
    inputSpendTag.inputs[0] <== 2006;
    inputSpendTag.inputs[1] <== inputSpendSecret;
    component inputNote = Poseidon(7);
    inputNote.inputs[0] <== 2010;
    inputNote.inputs[1] <== header.deployment;
    inputNote.inputs[2] <== inputAmount;
    inputNote.inputs[3] <== buyerAx;
    inputNote.inputs[4] <== buyerAy;
    inputNote.inputs[5] <== inputSpendTag.out;
    inputNote.inputs[6] <== inputSalt;
    component inputNull = Poseidon(4);
    inputNull.inputs[0] <== 2011;
    inputNull.inputs[1] <== header.deployment;
    inputNull.inputs[2] <== inputSpendSecret;
    inputNull.inputs[3] <== inputNote.out;
    inputNull.out === inputNullifier.value;
    component membership = MerkleRoot(depth);
    membership.leaf <== inputNote.out;
    membership.index <== inputLeafIndex;
    for (var i = 0; i < depth; i++) membership.siblings[i] <== inputPath[i];
    membership.root === oldRoot.value;

    component paymentNote = Poseidon(7);
    paymentNote.inputs[0] <== 2010;
    paymentNote.inputs[1] <== header.deployment;
    paymentNote.inputs[2] <== paymentAmount;
    paymentNote.inputs[3] <== sellerAx;
    paymentNote.inputs[4] <== sellerAy;
    paymentNote.inputs[5] <== recipientSpendTag;
    paymentNote.inputs[6] <== paymentSalt.out;
    paymentNote.out === paymentCommitment.value;
    component changeSpendTag = Poseidon(2);
    changeSpendTag.inputs[0] <== 2006;
    changeSpendTag.inputs[1] <== changeSpendSecret;
    component changeNote = Poseidon(7);
    changeNote.inputs[0] <== 2010;
    changeNote.inputs[1] <== header.deployment;
    changeNote.inputs[2] <== changeAmount;
    changeNote.inputs[3] <== buyerAx;
    changeNote.inputs[4] <== buyerAy;
    changeNote.inputs[5] <== changeSpendTag.out;
    changeNote.inputs[6] <== changeSalt;
    changeNote.out === changeCommitment.value;
    component distinctOutputs = IsEqual();
    distinctOutputs.in[0] <== paymentNote.out;
    distinctOutputs.in[1] <== changeNote.out;
    distinctOutputs.out === 0;

    component appendPayment = MerkleAppend(depth);
    appendPayment.oldRoot <== oldRoot.value;
    appendPayment.index <== oldIndex.value;
    appendPayment.leaf <== paymentNote.out;
    for (var i = 0; i < depth; i++) appendPayment.siblings[i] <== paymentAppendPath[i];
    component appendChange = MerkleAppend(depth);
    appendChange.oldRoot <== appendPayment.resultingRoot;
    appendChange.index <== oldIndex.value + 1;
    appendChange.leaf <== changeNote.out;
    for (var i = 0; i < depth; i++) appendChange.siblings[i] <== changeAppendPath[i];
    appendChange.resultingRoot === newRoot.value;
}

component main {public [digestHigh, digestLow]} = Transfer(20);
