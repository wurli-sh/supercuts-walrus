#[test_only]
module supercuts_pool::semantic_groth16_tests;

use sui::groth16;

fun verify(verifying_key: vector<u8>, proof: vector<u8>, inputs: vector<u8>): bool {
    let curve = groth16::bn254();
    let prepared = groth16::prepare_verifying_key(&curve, &verifying_key);
    let proof_points = groth16::proof_points_from_bytes(proof);
    let public_inputs = groth16::public_proof_inputs_from_bytes(inputs);
    groth16::verify_groth16_proof(&curve, &prepared, &public_inputs, &proof_points)
}

#[test]
fun verifies_semantic_deposit_proof() {
    let vk = x"";
    let proof = x"94fffb3778fc9a8ad985c16a278f5e7fa0708e8545d1f26869eb758d4470fb8f02665ee179d3a51ee089180b9d67a3779e63376c719d3025dfdeb9dc7d738a079c0a1625682c0dbb5662a313fc340cf7642a18d89d0233a9f35f8597a59de718c99ccd65a391a9a989f77ee435d1528e08581f32e1117d8db2050f8bf53f9198";
    let inputs = x"1c70451e3dd7ef3a6ee3926226ee7ffe00000000000000000000000000000000db7f4c180a53b99dd66d22c7c386c39300000000000000000000000000000000";
    assert!(verify(vk, proof, inputs));
}

