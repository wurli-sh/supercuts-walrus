#[test_only]
module supercuts_pool::v2_semantic_groth16_tests;

use sui::groth16;

fun verify(verifying_key: vector<u8>, proof: vector<u8>, inputs: vector<u8>): bool {
    let curve = groth16::bn254();
    let prepared = groth16::prepare_verifying_key(&curve, &verifying_key);
    let points = groth16::proof_points_from_bytes(proof);
    let public_inputs = groth16::public_proof_inputs_from_bytes(inputs);
    groth16::verify_groth16_proof(&curve, &prepared, &public_inputs, &points)
}

#[test]
fun verifies_v2_deposit_proof() {
    assert!(verify(x"", x"b692ac1174d9dcbd41afa0d22b365d41242138bb93bfc7ddd8ee556bcf5a910a17783c27ff299b726f17eaac6bfbb6d4983c9dc1e1462798d0b49b1b15a3800b97f7798e48f2b970357d14ae58c0e846d65f280fae9d68fa5d2debc4ab34dea5ec2b6d8fdd01422138f50784306e998830d662719f5ec9d014817b3fe27da796", x"65021c70a73f76be90e06969131bf59b00000000000000000000000000000000a8154d083d133e5f6d32baf97741ba5e00000000000000000000000000000000"));
}

