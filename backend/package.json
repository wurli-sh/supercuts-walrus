{
  "name": "@supercuts/backend",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "bin": {
    "supercuts": "dist/cli.js",
    "supercuts-demo": "dist/demo.js",
    "supercuts-mcp": "dist/mcp.js",
    "supercuts-resource": "dist/resource-server.js",
    "supercuts-facilitator": "dist/facilitator.js",
    "supercuts-seam": "dist/seam.js"
  },
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "test:e2e": "tsx --test test/phase2.e2e.test.ts",
    "test:phase3": "tsx --test test/phase3.e2e.test.ts",
    "test:sdk": "pnpm --dir packages/sdk test",
    "test:seal-live": "tsx scripts/seal-live-e2e.ts",
    "test:x402-live": "tsx scripts/x402-live-e2e.ts"
  },
  "dependencies": {
    "@mysten-incubation/memwal": "0.1.11",
    "@mysten/seal": "1.5.2",
    "@mysten/sui": "2.38.0",
    "@mysten/walrus": "1.2.37",
    "circomlibjs": "0.1.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
