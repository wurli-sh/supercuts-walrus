{
  "name": "@supercuts-walrus/sdk",
  "version": "0.1.2",
  "description": "Typed, role-scoped TypeScript SDK for Supercuts",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm --dir ../.. build",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@supercuts-walrus/backend": "workspace:0.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
